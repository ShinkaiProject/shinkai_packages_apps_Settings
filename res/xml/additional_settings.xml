<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:settings="http://schemas.android.com/apk/res-auto"
        android:key="additional_settings"
        android:title="@string/additional_settings_title">

    <!-- Default USB configuration -->
    <Preference
        android:key="default_usb_configuration"
        android:title="@string/usb_default_config_title"
        android:summary="@string/usb_default_config_summary"
        android:fragment="com.android.settings.connecteddevice.usb.UsbDefaultFragment" />

    <!-- Allow application downgrade -->
    <com.custom.settings.preferences.GlobalSettingSwitchPreference
        android:key="pm_downgrade_allowed"
        android:title="@string/miscellaneous_app_downgrade_title"
        android:summary="@string/miscellaneous_app_downgrade_summary"
        android:defaultValue="false" />

    <!-- Block PairIP license check -->
    <com.custom.settings.preferences.SystemPropertySwitchPreference
        android:key="persist.sys.pairip.activity.block"
        android:title="@string/miscellaneous_pairip_activity_block_title"
        android:summary="@string/miscellaneous_pairip_activity_block_summary"
        android:defaultValue="false" />

    <!-- Floating rotation button -->
    <com.custom.settings.preferences.SystemSettingSwitchPreference
        android:key="enable_rotation_button"
        android:title="@string/floating_rotation_button_title"
        android:summary="@string/floating_rotation_button_summary"
        android:defaultValue="true" />   

    <!-- Disable flash sms -->
    <com.custom.settings.preferences.SystemSettingSwitchPreference
        android:key="disable_flash_sms"
        android:title="@string/disable_flash_sms_title"
        android:summary="@string/disable_flash_sms_summary"
        android:defaultValue="false"/>

</PreferenceScreen>
